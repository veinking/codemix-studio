# Shared PocketBI ID frontend config (required for auth and explicit account/cloud features)
VITE_SUPABASE_URL=https://bozkwngfioubgwzvzfif.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-pocketbi-public-client-key

# PocketBI OAuth 2.1 public client (PKCE; no client secret in bIDE)
